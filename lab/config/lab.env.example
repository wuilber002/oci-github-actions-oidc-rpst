# Valores ficticios. Copie para lab.env e substitua pelos dados do ambiente.
# Nao colocar senhas nem tokens neste arquivo.
# Formato DONO/REPOSITORIO. Nao use URL https://, git@github.com: ou .git.
GITHUB_REPOSITORY=example-owner/example-repo
GITHUB_BRANCH=main
OCI_REGION=us-ashburn-1
OCI_COMPARTMENT_OCID=ocid1.compartment.oc1..SUBSTITUA_PELO_OCID
OCI_DOMAIN_URL=https://idcs-example.identity.oraclecloud.com
OCI_NAMESPACE=example_namespace
OCI_BUCKET=example-bucket

# Login administrativo local. A sessao nao e enviada ao GitHub.
OCI_ADMIN_PROFILE=GITHUB_OIDC_ADMIN
OCI_ADMIN_AUTH=security_token
OCI_APP_NAME=github-actions-oidc-lab
OCI_TRUST_NAME=github-actions-oidc-lab
OCI_POLICY_NAME=github-actions-oidc-lab
OIDC_AUDIENCE=oci-github-actions-lab
OCI_RES_TYPE=githubactions

# Opcionais: descobertos automaticamente quando vazios.
OCI_TENANCY_OCID=
OCI_DOMAIN_OCID=
# Compartimento que contem o Identity Domain, nao o bucket; vazio = tenancy.
OCI_DOMAIN_COMPARTMENT_OCID=
